# Copy to a private env file and pass ENV_FILE=... to scripts/train/ launchers.
PYTHON_BIN=/root/venvs/lerobot-pi05/bin/python
TORCHRUN=/root/venvs/lerobot-pi05/bin/torchrun
DATASET_ROOT=/mnt/cfs/usr/jixiang/train_datasets/lerobot_ee
MODEL_ROOT=/mnt/cfs/usr/jixiang/hf_models/pi05_base
TOKENIZER_ROOT=/mnt/cfs/usr/jixiang/hf_models/paligemma-3b-pt-224-tokenizer
NUM_GPUS=1
NUM_WORKERS=4
GRAD_ACCUM_STEPS=1
SAVE_FREQ=5000
CHUNK_SIZE=50
N_ACTION_STEPS=10
OPTIMIZER_LR=2.5e-5
SCHEDULER_WARMUP_STEPS=1000
SCHEDULER_DECAY_STEPS=30000
SCHEDULER_DECAY_LR=2.5e-6
LOG_FREQ=200
EVAL_STEPS=0
EVAL_SPLIT=0.05
IMAGE_AUGMENTATION=true
MLFLOW_ENABLE=true
MLFLOW_TRACKING_URI=https://mlflow.seer-robotics.cn
MLFLOW_EXPERIMENT_ID=20
MLFLOW_EXPERIMENT_NAME=openpi/pi05
MLFLOW_RUN_NAME_PREFIX=pi05
# Credentials are loaded from the ignored config/.mlflow.env file.
