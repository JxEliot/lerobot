# Copy to a private env file or pass ENV_FILE=... when launching run.sh.
PYTHON_BIN=/root/venvs/lerobot-pi05/bin/python
TORCHRUN=/root/venvs/lerobot-pi05/bin/torchrun
DATASET_ROOT=/mnt/cfs/usr/jixiang/train_datasets/lerobot_ee
MODEL_ROOT=/mnt/cfs/usr/jixiang/hf_models/pi05_base
